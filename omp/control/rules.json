{
  "version": 1,
  "toolApproval": {
    "eval": "deny"
  },
  "bashDeny": [
    "*git push",
    "*git push *",
    "*git -* push",
    "*git -* push *",
    "*gh pr create*",
    "*gh pr new*",
    "*gh pr merge*",
    "*gh pr comment*",
    "*gh pr review*",
    "*gh pr edit*",
    "*gh pr close*",
    "*gh pr reopen*",
    "*gh pr ready*",
    "*gh pr lock*",
    "*gh pr unlock*",
    "*gh pr update-branch*",
    "*gh issue create*",
    "*gh issue new*",
    "*gh issue comment*",
    "*gh issue edit*",
    "*gh issue close*",
    "*gh issue reopen*",
    "*gh issue delete*",
    "*gh issue transfer*",
    "*gh issue lock*",
    "*gh issue unlock*",
    "*gh issue pin*",
    "*gh issue unpin*",
    "*gh issue develop*",
    "*gh release create*",
    "*gh release new*",
    "*gh release edit*",
    "*gh release delete*",
    "*gh release upload*",
    "*gh repo create*",
    "*gh repo new*",
    "*gh repo delete*",
    "*gh repo edit*",
    "*gh repo rename*",
    "*gh repo archive*",
    "*gh repo unarchive*",
    "*gh repo fork*",
    "*gh repo sync*",
    "*gh repo deploy-key add*",
    "*gh repo deploy-key delete*",
    "*gh secret set*",
    "*gh secret delete*",
    "*gh variable set*",
    "*gh variable delete*",
    "*gh label create*",
    "*gh label edit*",
    "*gh label delete*",
    "*gh label clone*",
    "*gh workflow run*",
    "*gh workflow enable*",
    "*gh workflow disable*",
    "*gh run rerun*",
    "*gh run cancel*",
    "*gh run delete*",
    "*gh gist create*",
    "*gh gist new*",
    "*gh gist edit*",
    "*gh gist delete*",
    "*gh gist rename*",
    "*gh api* -X*",
    "*gh api* --method*",
    "*gh api* -f*",
    "*gh api* -F*",
    "*gh api* --field*",
    "*gh api* --raw-field*",
    "*gh api* --input*",
    "*origin pr create*",
    "*origin pr merge*",
    "*origin pr edit*",
    "*origin pr ready*",
    "*origin pr comment*",
    "*origin pr review*",
    "*origin pr thread*",
    "*origin pr close*",
    "*origin pr reopen*",
    "*omp config set*",
    "*omp config reset*",
    "*omp config init-xdg*",
    "*.omp/agent/config.yml*",
    "*.omp/agent/config.yaml*",
    "*.omp/agent/agents*",
    "*{agentDir}/config.yml*",
    "*{agentDir}/config.yaml*",
    "*{agentDir}/agents*",
    "*pstack-omp/omp*"
  ],
  "github": {
    "denyOps": ["pr_create", "pr_push"]
  },
  "task": {
    "denyIsolated": true,
    "subAgents": ["task", "poteto-agent"]
  },
  "protectedPaths": [
    "{workDir}/",
    "{agentDir}/config.yml",
    "{agentDir}/config.yaml",
    "{agentDir}/settings.json",
    "{agentDir}/agents/",
    "{agentDir}/extensions/",
    "{agentDir}/tools/",
    "{agentDir}/hooks/",
    "{home}/.omp/plugins/",
    "{home}/.bunfig.toml",
    "{ompBin}",
    "{bunBin}"
  ],
  "projectPaths": [
    ".omp/",
    ".pi/",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/settings.yml",
    ".claude/settings.yaml",
    ".claude/tools/",
    ".claude/extensions/",
    ".codex/tools/",
    ".codex/extensions/"
  ],
  "allowPaths": ["{home}/.omp/"]
}
